# Base URL for the FastAPI service. Include the version prefix.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Public branding is read at GET <base>/tenancy/public/<slug>. Defaults to propflow.
# This selects display branding only; all authorization comes from the API session.
VITE_TENANT_SLUG=propflow
