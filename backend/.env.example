# ---------------------------------------------------------------------------
# PropFlow backend local-development template.
# Copy this file to `.env` and replace every placeholder value before use.
# Never commit the resulting `.env` file.
# ---------------------------------------------------------------------------

APP_NAME=PropFlow API
ENVIRONMENT=development
API_VERSION=v1
DEBUG=true
LOG_LEVEL=INFO

# SQLAlchemy URL. Keep the password URL-encoded if it contains special chars.
DATABASE_URL=postgresql+psycopg2://propflow:change-me-local-dev@localhost:5432/propflow_db

# JSON list (or comma-separated list) of allowed browser origins.
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Generate a real secret with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
# The placeholder below is rejected when ENVIRONMENT=production.
JWT_SECRET_KEY=change-me-use-a-random-64-character-secret-key-for-jwt-signing
JWT_ALGORITHM=HS256
JWT_ISSUER=propflow-api
JWT_AUDIENCE=propflow-clients
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Groq AI Assistant configuration
# Obtain an API key from https://console.groq.com/
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Optional generic OpenAI-compatible AI provider (OpenAI, Azure, Together, self-hosted).
# When set, takes precedence over Groq for chat completions.
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini

# SMTP configuration for outbound email (password reset, etc.).
# Leave SMTP_HOST unset to log reset links instead of sending email (dev).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM_EMAIL=noreply@propflow.local
# SMTP_FROM_NAME=PropFlow

# Base URL of the PropFlow frontend, used to build password-reset links.
FRONTEND_BASE_URL=http://localhost:5173

# Lifetime (minutes) of a single-use password-reset token.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Used by docker-compose.yml. POSTGRES_PASSWORD must match DATABASE_URL.
POSTGRES_DB=propflow_db
POSTGRES_USER=propflow
POSTGRES_PASSWORD=change-me-local-dev
POSTGRES_PORT=5432

# Messaging trigger engine (LogProvider default works with zero keys).
MESSAGING_PROVIDER_DEFAULT=log
MESSAGING_DISPATCH_ENABLED=true
MESSAGING_DISPATCH_POLL_INTERVAL_SECONDS=30
MESSAGING_DISPATCH_BATCH_SIZE=50

# Live provider credentials (optional; required only when that channel is enabled).
# GUPSHUP_API_KEY=
# GUPSHUP_APP_NAME=
# GUPSHUP_SOURCE_NUMBER=
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=

# SaaS operator control plane (trusted bootstrap only, not a public registration).
# OPERATOR_BOOTSTRAP_EMAIL=owner@yourco.com
# OPERATOR_BOOTSTRAP_PASSWORD=
OPERATOR_TOKEN_EXPIRE_MINUTES=60

# Encrypted tenant credential vault (required in production for provider secrets).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

